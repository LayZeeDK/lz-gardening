{
  "name": "tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["lz-gardening"],
  "namedInputs": { "default": ["{projectRoot}/**/*", "sharedGlobals", "{workspaceRoot}/eslint.config.ts"] },
  "targets": {
    "test": {
      "command": "node --test \"*.test.ts\" \"nx/*.test.ts\"",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    }
  }
}
