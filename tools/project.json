{
  "name": "tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["tometo"],
  "namedInputs": { "default": ["{projectRoot}/**/*", "sharedGlobals", "{workspaceRoot}/eslint.config.ts"] },
  "targets": {
    "test": {
      "command": "node --test \"*.test.ts\" \"nx/*.test.ts\" \"evals/*.test.ts\"",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "mutate": {
      "command": "node --conditions=@layzee/source node_modules/@stryker-mutator/core/bin/stryker.js run tools/stryker.config.mjs",
      "cache": false,
      "parallelism": false
    }
  }
}
