{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"]
  },
  "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false } },
  "plugins": [
    "./tools/nx/claude-plugin.ts",
    { "plugin": "@nx/eslint/plugin", "options": { "targetName": "lint" } },
    { "plugin": "@nx/js/typescript", "options": { "typecheck": { "targetName": "typecheck" }, "build": false } }
  ],
  "targetDefaults": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.ts",
        {
          "externalDependencies": [
            "eslint",
            "typescript-eslint",
            "typescript",
            "@nx/eslint-plugin",
            "jsonc-eslint-parser"
          ]
        },
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "typecheck": { "inputs": ["default", "^default", { "externalDependencies": ["typescript", "@types/node"] }] }
  }
}
