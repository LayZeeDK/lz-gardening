{
  "name": "tometo-tooling",
  "private": true,
  "type": "module",
  "description": "Maintainer tooling for the tometo repository: type-check, lint and test the scripts the plugin ships. Not part of the plugin.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix plugins/tometo --ignore-scripts --no-audit --no-fund",
    "check": "nx run-many -t lint typecheck test lockfile && prettier --check --cache ."
  },
  "devDependencies": {
    "@nx/devkit": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/rule-tester": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "eslint": "10.13.0",
    "jiti": "2.6.1",
    "jsonc-eslint-parser": "3.3.0",
    "nx": "24.0.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
